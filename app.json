{
  "expo": {
    "name": "Matriz Contable CR",
    "slug": "matriz-contable-",
    "owner": "matriz-contable1s-team",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d7a0c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kcnstudio.matrizcontablecr",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para proteger el acceso a tus datos contables dentro de la app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kcnstudio.matrizcontablecr",
      "versionCode": 1,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "371b98ad-b4a8-4410-801e-58e25582b893"
      }
    }
  }
}
